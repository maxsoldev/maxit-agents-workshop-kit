            },
            {
              "name": "name",
              "value": "*"
            }
          ]
        }
      },
      "notes": "Reads all the rules: n8n/rules/*.md",
      "notesInFlow": true
    },
    {
      "id": "8b75f22f-89e8-4cbf-bc75-8d3d5a17934d",
      "name": "Read message",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        560,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{PROMPT:read_message.input}}",
        "messages": {
          "messageValues": [
            {
              "message": "={{PROMPT:read_message}}"
            }
          ]
        }
      },
      "notes": "AI: what, who, which days",
      "notesInFlow": true
    },
    {
      "id": "1c390e6c-af80-4dde-b7fd-d22e7a980a7e",
      "name": "Message fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The model answers JSON text, in the Response Format of its model node. Read it into `output`.\n// Also takes {\"output\": {...}} or a ```json block, so a good answer never stops the workflow.\nconst text = $json.text.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst answer = JSON.parse(text);\nconst wrapped = answer.output && typeof answer.output === 'object' && Object.keys(answer).length === 1;\nreturn { json: { output: wrapped ? answer.output : answer } };"
      },
      "notes": "Reads the AI answer",
      "notesInFlow": true
    },
    {
      "id": "a1c63fc3-8bab-4c2e-9fe3-07723fb42b73",
      "name": "Read model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        560,
        300
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "{{KIT_MODEL}}"
        },
        "responsesApiEnabled": true,
        "options": {
          "timeout": 100000,
          "maxRetries": 1,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "message_fields",
              "schema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"about\",\n    \"person\",\n    \"date_from\",\n    \"date_to\"\n  ],\n  \"properties\": {\n    \"about\": {\n      \"type\": \"string\"\n    },\n    \"person\": {\n      \"type\": \"string\"\n    },\n    \"date_from\": {\n      \"type\": \"string\"\n    },\n    \"date_to\": {\n      \"type\": \"string\"\n    }\n  }\n}"
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "{{OPENAI_CREDENTIAL_ID}}",
          "name": "Kit OpenAI"
        }
      }
    },
    {
      "id": "c8199b04-a38d-4bbb-851a-15f26aa7a37f",
      "name": "Look up events on those days",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
