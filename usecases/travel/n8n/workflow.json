      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "{{KIT_TOOLS_URL}}/call/rules_get",
        "sendBody": true,
