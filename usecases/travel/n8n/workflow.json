        "specifyBody": "keypair",
        "options": {
          "timeout": 60000
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "date_from",
              "value": "={{ $json.output.date_from }}"
            },
            {
              "name": "date_to",
              "value": "={{ $json.output.date_to }}"
            }
          ]
        }
      },
      "notes": "Reads data/events.csv",
      "notesInFlow": true
    },
    {
      "id": "f852f209-d402-41bf-9a74-f9dd3cbc8fd0",
