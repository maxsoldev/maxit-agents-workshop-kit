    {
      "id": "b00a9d2e-c35c-4a00-a02a-50196355de40",
      "name": "Triage",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        560,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{PROMPT:triage.input}}",
        "messages": {
          "messageValues": [
            {
              "message": "={{PROMPT:triage}}"
            }
          ]
        }
      },
      "notes": "AI: sorts the email",
      "notesInFlow": true
    },
    {
      "id": "e44b02b5-7d93-454b-a774-3d76a8379447",
      "name": "Triage fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The model answers JSON text, in the Response Format of its model node. Read it into `output`.\n// Also takes {\"output\": {...}} or a ```json block, so a good answer never stops the workflow.\nconst text = $json.text.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '');\nconst answer = JSON.parse(text);\nconst wrapped = answer.output && typeof answer.output === 'object' && Object.keys(answer).length === 1;\nreturn { json: { output: wrapped ? answer.output : answer } };"
      },
      "notes": "Reads the AI answer",
      "notesInFlow": true
    },
    {
      "id": "8c59aa8d-824f-4be1-bcb5-4572b50ad9c7",
      "name": "Triage model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        560,
        300
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "{{KIT_MODEL}}"
        },
        "responsesApiEnabled": true,
        "options": {
          "timeout": 100000,
          "maxRetries": 1,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "triage",
              "schema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"category\",\n    \"flags\",\n    \"no_reply\",\n    \"sender_email\",\n    \"reason\"\n  ],\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"flags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"no_reply\": {\n      \"type\": \"boolean\"\n    },\n    \"sender_email\": {\n      \"type\": \"string\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  }\n}"
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "{{OPENAI_CREDENTIAL_ID}}",
          "name": "Kit OpenAI"
        }
      }
    },
    {
      "id": "24d811f6-1f79-44a1-8b18-23a9e1511667",
      "name": "Junk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fd4a1415-0606-4da6-a4a9-7334c21326bd",
              "leftValue": "={{ $json.output.no_reply === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "Junk? Then no reply",
      "notesInFlow": true
    },
    {
      "id": "e5455725-ffba-4834-b08f-c7ba441627ae",
      "name": "Result: no reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        -260
      ],
      "parameters": {
        "jsCode": "// No reply and no more model calls: build the result in code, in the shape of the case schema.\nconst triage = $('Triage fields').first().json.output;\nconst schema = $('Case in').first().json.body.output_schema;\nconst result = { category: triage.category, flags: triage.flags, reply: '', reasons: 'No reply. ' + triage.reason };\n// Only the fields of the schema; a required field we do not know (e.g. route_to) gets an empty value.\nconst output = {};\nfor (const [key, prop] of Object.entries(schema.properties)) {\n  if (key in result) output[key] = result[key];\n  else if ((schema.required || []).includes(key)) output[key] = prop.type === 'array' ? [] : prop.type === 'boolean' ? false : '';\n}\nreturn [{ json: { output } }];"
      },
      "notes": "No AI call",
      "notesInFlow": true
    },
    {
      "id": "efaa1683-2596-4c0e-b90e-7bd883da73a5",
      "name": "Look up the sender in the contact sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "{{KIT_TOOLS_URL}}/call/contacts_lookup",
        "sendBody": true,
        "specifyBody": "keypair",
        "options": {
          "timeout": 60000
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $('Triage fields').item.json.output.sender_email }}"
            }
          ]
        }
      },
      "notes": "Reads data/contacts.csv",
      "notesInFlow": true
    },
    {
      "id": "e77f7ab2-b5ba-4fb6-8825-5dab4b615932",
      "name": "Find earlier emails from the sender",
