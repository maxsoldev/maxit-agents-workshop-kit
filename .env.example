# Kit settings. Copy this file: `cp .env.example .env`, then set OPENAI_API_KEY.
# One KEY=value per line. Put comments on their own line (Docker Compose also reads this file).
# The defaults are for your own laptop only: all ports listen on 127.0.0.1.

# ---------- Model ----------
# Your OpenAI key. The n8n credential, the Python engine and the judge use it.
OPENAI_API_KEY=
# Empty = OpenAI. Or the URL of an OpenAI-compatible gateway (LiteLLM, Azure, your company proxy), e.g.
# http://localhost:4000/v1. Then KIT_MODEL and KIT_JUDGE_MODEL are the gateway's model names.
OPENAI_BASE_URL=
KIT_MODEL=gpt-6-luna
KIT_JUDGE_MODEL=gpt-6.1-terra

# ---------- Kit (runs on the host) ----------
# The engines your team uses, e.g. claude,python. Empty = all (n8n,claude,python).
# make up, make setup and make check skip the others; the Run page shows only these.
KIT_ENGINES=
KIT_UI_PORT=5700
KIT_TOOLS_PORT=5701

# ---------- Ports and name of the Docker stack ----------
# Change these only to run 2 kits on one computer: then give each its own name and ports,
# and change N8N_URL and LANGFUSE_HOST below to match.
COMPOSE_PROJECT_NAME=maxit-kit
N8N_PORT=5702
LANGFUSE_PORT=5703

# ---------- Trains (tool trains_search) ----------
# Our MOTIS server. The trainer gives the URL on the day. Empty = use only the fallback.
TRAINS_URL=
TRAINS_FALLBACK_URL=https://api.transitous.org

# ---------- n8n ----------
# local = n8n in Docker on :5702 (`make up` starts it). hosted = the trainer's n8n (set N8N_URL and N8N_API_KEY).
N8N=local
N8N_URL=http://localhost:5702
# Local: `make setup` creates this owner account. Log in to n8n with it.
N8N_OWNER_EMAIL=kit@example.com
N8N_OWNER_PASSWORD=KitLocal1234
# Local: `make setup` writes the next three. Hosted: the trainer gives the API key.
N8N_API_KEY=
N8N_OPENAI_CREDENTIAL_ID=
# A short hash of OPENAI_API_KEY (not the key): setup updates the n8n credential when the key changes.
N8N_OPENAI_KEY_FINGERPRINT=

# ---------- Langfuse (traces) ----------
# local = Langfuse in Docker on :5703. hosted = the trainer's Langfuse (set host and keys). off = no traces.
LANGFUSE=local
LANGFUSE_HOST=http://localhost:5703
# Local: Langfuse creates a project with these keys at first start. Hosted: the keys of your team's project.
LANGFUSE_PUBLIC_KEY=pk-lf-kit-local
LANGFUSE_SECRET_KEY=sk-lf-kit-local
# Local: log in to Langfuse with this account.
LANGFUSE_INIT_USER_EMAIL=kit@example.com
LANGFUSE_INIT_USER_PASSWORD=kit-local-password
