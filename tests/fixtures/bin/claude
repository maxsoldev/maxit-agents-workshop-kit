#!/usr/bin/env python3
"""Fake `claude` for the runner tests: prints the shape of `claude -p ... --output-format json`.
With --json-schema, the answer is also in `structured_output` (as Claude Code does). Mode "text": only the text
in input `answer` (no structured_output)."""
import json
import os
import sys

prompt = sys.argv[sys.argv.index("-p") + 1]
case = json.loads(prompt.split("\n\n", 1)[1])
inp = case["input"]
schema = json.loads(sys.argv[sys.argv.index("--json-schema") + 1]) if "--json-schema" in sys.argv else None
if schema is not None and "$schema" in schema:
    print("Error: --json-schema is not a valid JSON Schema", file=sys.stderr)
    sys.exit(1)
if inp.get("mode") == "crash":
    print(json.dumps({"type": "result", "subtype": "success", "is_error": True, "result": "Not logged in"}))
    sys.exit(1)
answer = {"category": inp.get("want", 5) if inp.get("mode") == "ok" else 5, "reply": inp.get("note", "hi"), "tags": ["x"]}
text = "Here it is:\n```json\n" + json.dumps(answer) + "\n```"
result = {"type": "result", "subtype": "success", "is_error": False, "result": text, "num_turns": 2,
          "total_cost_usd": 0.01, "duration_ms": 5, "traceparent": os.environ.get("TRACEPARENT")}
if inp.get("mode") == "text":
    result["result"] = inp["answer"]
elif schema is not None:
    result.update(result=json.dumps(answer), structured_output=answer)
print(json.dumps(result))
